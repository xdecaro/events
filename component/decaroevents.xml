<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_DECAROEVENTS</name>
  <author>Luca De Caro</author>
  <creationDate>2026-09</creationDate>
  <copyright>Copyright (C) 2026 Luca De Caro. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorUrl>https://github.com/xdecaro/events</authorUrl>
  <version>1.1.0</version>
  <description>COM_DECAROEVENTS_XML_DESCRIPTION</description>
  <targetplatform name="joomla" version="(5|6).*" />
  <php_minimum>8.1.0</php_minimum>
  <namespace path="src">Xdecaro\Component\Decaroevents</namespace>
  <files folder="site">
    <folder>src</folder><folder>tmpl</folder><folder>language</folder>
  </files>
  <administration>
    <menu img="class:calendar">COM_DECAROEVENTS</menu>
    <submenu>
      <menu view="events">COM_DECAROEVENTS_EVENTS</menu>
      <menu view="sessions">COM_DECAROEVENTS_SESSIONS</menu>
      <menu view="registrations">COM_DECAROEVENTS_REGISTRATIONS</menu>
      <menu view="information">COM_DECAROEVENTS_INFORMATION</menu>
    </submenu>
    <files folder="admin">
      <filename>access.xml</filename><filename>config.xml</filename><folder>forms</folder><folder>services</folder><folder>sql</folder><folder>src</folder><folder>tmpl</folder>
    </files>
    <languages folder="admin/language">
      <language tag="en-GB">en-GB/com_decaroevents.ini</language><language tag="en-GB">en-GB/com_decaroevents.sys.ini</language>
      <language tag="it-IT">it-IT/com_decaroevents.ini</language><language tag="it-IT">it-IT/com_decaroevents.sys.ini</language>
    </languages>
  </administration>
  <install><sql><file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8mb4.sql</file></sql></install>
  <update><schemas><schemapath type="mysql">sql/updates/mysql</schemapath></schemas></update>
</extension>
