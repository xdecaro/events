<?xml version="1.0" encoding="utf-8"?>
<form><fieldset name="details">
  <field name="id" type="hidden" />
  <field name="event_id" type="sql" label="COM_DECAROEVENTS_EVENT" query="SELECT id AS value, title AS text FROM #__decaroevents_events ORDER BY title" key_field="value" value_field="text" required="true" />
  <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" />
  <field name="location" type="text" label="COM_DECAROEVENTS_FIELD_LOCATION" maxlength="255" />
  <field name="start_at" type="calendar" label="COM_DECAROEVENTS_FIELD_START" required="true" showtime="true" filter="user_utc" />
  <field name="end_at" type="calendar" label="COM_DECAROEVENTS_FIELD_END" showtime="true" filter="user_utc" />
  <field name="capacity" type="number" label="COM_DECAROEVENTS_FIELD_CAPACITY" min="0" hint="COM_DECAROEVENTS_SESSION_CAPACITY_INHERIT" />
  <field name="published" type="list" label="JSTATUS" default="1"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option></field>
</fieldset></form>
