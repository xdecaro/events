<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter">
    <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER_LABEL" hint="COM_DECAROEVENTS_FILTER_REGISTRATIONS_SEARCH" />
    <field name="event_id" type="sql" label="COM_DECAROEVENTS_EVENT" class="js-select-submit-on-change" query="SELECT id AS value, title AS text FROM #__decaroevents_events ORDER BY title" key_field="value" value_field="text">
      <option value="">COM_DECAROEVENTS_FILTER_ALL_EVENTS</option>
    </field>
    <field name="status" type="list" label="JSTATUS" class="js-select-submit-on-change">
      <option value="">COM_DECAROEVENTS_FILTER_ALL_STATUSES</option>
      <option value="pending">COM_DECAROEVENTS_STATUS_PENDING</option>
      <option value="confirmed">COM_DECAROEVENTS_STATUS_CONFIRMED</option>
      <option value="waitlist">COM_DECAROEVENTS_STATUS_WAITLIST</option>
      <option value="cancelled">COM_DECAROEVENTS_STATUS_CANCELLED</option>
    </field>
    <field name="checked_in" type="list" label="COM_DECAROEVENTS_FIELD_CHECKED_IN" class="js-select-submit-on-change">
      <option value="">COM_DECAROEVENTS_FILTER_ALL_CHECKIN</option>
      <option value="1">COM_DECAROEVENTS_FILTER_CHECKED_IN</option>
      <option value="0">COM_DECAROEVENTS_FILTER_NOT_CHECKED_IN</option>
    </field>
  </fields>
  <fields name="list">
    <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" class="js-select-submit-on-change" default="r.created DESC">
      <option value="r.created DESC">COM_DECAROEVENTS_SORT_CREATED_DESC</option>
      <option value="r.created ASC">COM_DECAROEVENTS_SORT_CREATED_ASC</option>
      <option value="r.name ASC">COM_DECAROEVENTS_SORT_NAME_ASC</option>
      <option value="r.name DESC">COM_DECAROEVENTS_SORT_NAME_DESC</option>
      <option value="e.title ASC">COM_DECAROEVENTS_SORT_EVENT_ASC</option>
      <option value="e.title DESC">COM_DECAROEVENTS_SORT_EVENT_DESC</option>
    </field>
    <field name="limit" type="limitbox" class="input-mini js-select-submit-on-change" default="25" />
  </fields>
</form>
